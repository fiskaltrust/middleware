<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed by MiddlewareHost, which serves the in-memory middleware over HTTP. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../storage/src/fiskaltrust.storage/fiskaltrust.storage.csproj" />

    <ProjectReference Include="../../../../queue/src/fiskaltrust.Middleware.Queue.InMemory/fiskaltrust.Middleware.Queue.InMemory.csproj" />

    <ProjectReference Include="../../../../queue/src/fiskaltrust.Middleware.Localization.v2/fiskaltrust.Middleware.Localization.v2.csproj" />

    <ProjectReference Include="../../../../queue/src/fiskaltrust.Middleware.Localization.QueueES/fiskaltrust.Middleware.Localization.QueueES.csproj" />
    <ProjectReference Include="../../../../queue/src/fiskaltrust.Middleware.Localization.QueuePL/fiskaltrust.Middleware.Localization.QueuePL.csproj" />
    <ProjectReference Include="../../../../scu-pl/src/fiskaltrust.Middleware.SCU.PL.InMemory/fiskaltrust.Middleware.SCU.PL.InMemory.csproj" />
    <ProjectReference Include="../../../../scu-pl/src/fiskaltrust.Middleware.SCU.PL.PosNet/fiskaltrust.Middleware.SCU.PL.PosNet.csproj" />
    <ProjectReference Include="../../../../scu-pl/test/fiskaltrust.Middleware.SCU.PL.TestSupport/fiskaltrust.Middleware.SCU.PL.TestSupport.csproj" />
    <ProjectReference Include="../../../../scu-es/src/fiskaltrust.Middleware.SCU.ES.VeriFactu/fiskaltrust.Middleware.SCU.ES.VeriFactu.csproj" />
    <ProjectReference Include="../../../../scu-es/src/fiskaltrust.Middleware.SCU.ES.TicketBaiAraba/fiskaltrust.Middleware.SCU.ES.TicketBaiAraba.csproj" />
    <ProjectReference Include="../../../../scu-es/src/fiskaltrust.Middleware.SCU.ES.TicketBaiBizkaia/fiskaltrust.Middleware.SCU.ES.TicketBaiBizkaia.csproj" />
    <ProjectReference Include="../../../../scu-es/src/fiskaltrust.Middleware.SCU.ES.TicketBaiGipuzkoa/fiskaltrust.Middleware.SCU.ES.TicketBaiGipuzkoa.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="json-requests/**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- The Polish business cases are owned by the end-to-end acceptance suite, which asserts them
         against the register; the launcher serves the very same files as its PL samples. -->
    <None Include="../../../../scu-pl/test/fiskaltrust.Middleware.SCU.PL.EndToEnd.AcceptanceTest/BusinessCases/**" LinkBase="json-requests/PL">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="TestCertificates/**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="configuration/**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Not committed, supplied per developer: a market without a cashbox configuration is run
         from these, so they have to reach the output folder like they always did. -->
    <None Update="queue-configuration*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="scu-configuration*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
