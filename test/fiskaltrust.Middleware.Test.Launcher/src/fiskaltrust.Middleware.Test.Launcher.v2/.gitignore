json-requests/*
!json-requests/FR

# Cashbox configurations: the PL ones point at the office test printer and carry no
# credentials, so they survive a fresh clone. Other markets carry certificates.
configuration/*
!configuration/PL

# Per-package configurations carry certificates too. The FR in-memory pair carries none.
queue-configuration*.json
!queue-configuration-fr.json
scu-configuration*.json
!scu-configuration-fr-inmemory.json
