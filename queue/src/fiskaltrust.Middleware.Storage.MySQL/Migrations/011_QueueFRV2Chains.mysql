-- The QueueFR v2 chain columns of ftQueueFR (market-fr ADR 0012).
-- MySQL commits each DDL statement on its own, so every column is added only when missing and the
-- script can run again after an interruption.

SET @statement = (SELECT IF(COUNT(*) = 0, 'ALTER TABLE ftQueueFR ADD COLUMN ENumerator BIGINT NOT NULL DEFAULT 0', 'DO 0')
    FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'ftQueueFR' AND COLUMN_NAME = 'ENumerator');
PREPARE migration_step FROM @statement;
EXECUTE migration_step;
DEALLOCATE PREPARE migration_step;

