-- The QueueFR v2 chain columns of ftQueueFR (market-fr ADR 0012).
-- The columns are added in one transaction, so an interruption leaves the table as it was and the
-- migration runs again from the start.
-- The version is recorded in the same transaction, so a run that committed is never replayed.
BEGIN TRANSACTION;
ALTER TABLE ftQueueFR ADD COLUMN ENumerator BIGINT NOT NULL DEFAULT 0;
ALTER TABLE ftQueueFR ADD COLUMN SNumerator BIGINT NOT NULL DEFAULT 0;
ALTER TABLE ftQueueFR ADD COLUMN ZNumerator BIGINT NOT NULL DEFAULT 0;
ALTER TABLE ftQueueFR ADD COLUMN MNumerator BIGINT NOT NULL DEFAULT 0;
ALTER TABLE ftQueueFR ADD COLUMN YNumerator BIGINT NOT NULL DEFAULT 0;
ALTER TABLE ftQueueFR ADD COLUMN TLastSignature NVARCHAR(2147483647) NULL;
ALTER TABLE ftQueueFR ADD COLUMN PLastSignature NVARCHAR(2147483647) NULL;
ALTER TABLE ftQueueFR ADD COLUMN ILastSignature NVARCHAR(2147483647) NULL;
ALTER TABLE ftQueueFR ADD COLUMN BLastSignature NVARCHAR(2147483647) NULL;
ALTER TABLE ftQueueFR ADD COLUMN LLastSignature NVARCHAR(2147483647) NULL;
ALTER TABLE ftQueueFR ADD COLUMN CLastSignature NVARCHAR(2147483647) NULL;
ALTER TABLE ftQueueFR ADD COLUMN XLastSignature NVARCHAR(2147483647) NULL;
ALTER TABLE ftQueueFR ADD COLUMN ELastSignature NVARCHAR(2147483647) NULL;
ALTER TABLE ftQueueFR ADD COLUMN SLastSignature NVARCHAR(2147483647) NULL;
ALTER TABLE ftQueueFR ADD COLUMN ZLastSignature NVARCHAR(2147483647) NULL;
ALTER TABLE ftQueueFR ADD COLUMN MLastSignature NVARCHAR(2147483647) NULL;
ALTER TABLE ftQueueFR ADD COLUMN YLastSignature NVARCHAR(2147483647) NULL;
UPDATE ftDatabaseSchema SET CurrentVersion = '015_QueueFRV2Chains';
COMMIT;
