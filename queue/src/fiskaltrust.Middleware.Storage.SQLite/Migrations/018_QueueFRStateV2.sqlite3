-- The QueueFR v2 state that has no v1 column (market-fr ADR 0012, 0018, 0003).
-- The column is added in a transaction, so an interruption leaves the table as it was.
-- The version is recorded in the same transaction, so a run that committed is never replayed.
BEGIN TRANSACTION;
ALTER TABLE ftQueueFR ADD COLUMN StateV2 NVARCHAR(2147483647) NULL;
UPDATE ftDatabaseSchema SET CurrentVersion = '018_QueueFRStateV2';
COMMIT;
